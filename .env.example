# Which engine transcribes audio: "openai" (any OpenAI-compatible API) or "local" (faster-whisper, offline).
TRANSCRIBER=openai

# --- TRANSCRIBER=openai -------------------------------------------------------
# Works with OpenAI, Groq (https://api.groq.com/openai/v1/audio/transcriptions) or a self-hosted whisper server.
OPENAI_API_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

# --- TRANSCRIBER=local --------------------------------------------------------
# tiny | base | small | medium | large-v3 (bigger = more accurate, slower). Downloaded on first use.
LOCAL_MODEL=base
LOCAL_DEVICE=cpu

# Optional: require clients to send "Authorization: Bearer <API_KEY>". Leave empty to disable.
API_KEY=
MAX_AUDIO_MB=25
