# Default engine: "openai", "groq" or "local" (faster-whisper, offline). Users can switch in the UI.
TRANSCRIBER=openai

# Server-side provider keys are optional: users can paste their own key in the UI instead.
# --- OpenAI (or an OpenAI-compatible self-hosted whisper server via OPENAI_API_URL) ---
OPENAI_API_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

# --- Groq ---------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# --- Local (faster-whisper, needs requirements-local.txt) ----------------------
# Default local model: tiny | base | small | medium | large-v3. Downloaded on first use.
LOCAL_MODEL=base
LOCAL_DEVICE=cpu

# Optional access key protecting this agent (the "Access key" field in the UI). Leave empty to disable.
API_KEY=
MAX_AUDIO_MB=25
